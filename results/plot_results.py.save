import plotly.graph_objects as go

data = {
    'Min Latency': 45.35,
    'Max Latency': 45.94,
    'Avg Latency': 45.83,
    'Throughput': 400.6,
    'Total Transaction': 1500,
    'Test Load': 500,
    'Block Finality': 2035.07
}

categories = list(data.keys())

values = [
    data['Min Latency'],
    data['Max Latency'],
    data['Avg Latency'],
    data['Throughput'],
    data['Total Transaction'] / 10, 
    data['Test Load'],
    data['Block Finality'] / 10
]

fig = go.Figure()
fig.add_trace(go.Scatterpolar(r=values, theta=categories, fill='toself', line_color='teal'))
fig.update_layout(polar=dict(radialaxis=dict(visible=True, range=[0, 500])), title="Medical Security Project Metrics")
fig.write_html("my_chart.html")import plotly.graph_objects as go
data = {'min_latency': 45.35, 'max_latency': 46.57, 'avg_latency': 45.81, 'throughput': 402.8}
categories = ['Avg Latency', 'Throughput', 'Min Latency', 'Max Latency', 'Stability']
values = [data['avg_latency'], data['throughput'] / 5, data['min_latency'], data['max_latency'], 90]
fig = go.Figure()
fig.add_trace(go.Scatterpolar(r=values, theta=categories, fill='toself', line_color='teal'))
fig.update_layout(polar=dict(radialaxis=dict(visible=True, range=[0, 450])), title="Medical Security Performance")
fig.write_html("my_chart.html")
